return(list(ylist = ylist,
X = X,
countslist = countslist,
sparsecounts_list = sparsecounts_list,
ybin_all = ybin_all,
## The true generating model:
noisetype = noisetype,
mnmat = mnmat,
prob = prob,
mn = mn,
alpha = alpha,
beta = beta,
omega = omega,
mn_shift = mn_shift,
variance = variance
))
}
