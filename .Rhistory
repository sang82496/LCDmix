TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = TRUE,
df             = NULL,
skew_alpha     = NULL,
gap            = 4
) {
## Setup and basic checks
assertthat::assert_that(nt %% 5 ==0)
ntlist = c(rep(0.8 * nt, TT/2), rep(nt, TT/2))
K = 2
stopifnot(p >= 3)
if (is_heavytail){
assertthat::assert_that(!is.null(df))
} else {
assertthat::assert_that(!is.null(skew_alpha))
}
if(!is.null(seed)) set.seed(seed)
## Generate covariate
par = readRDS(file.path(datadir, "simul_helper.rds"))
Xrest = do.call(cbind, lapply(1:(p-2), function(ii) rnorm(TT)) )
X = cbind(scale(par[1:TT]), c(rep(0, TT/2), rep(1, TT/2)), Xrest)## p-2 columns
colnames(X) = c("par", "cp", paste0("noise", 1:(p-2)))
## Beta coefficients
beta = matrix(0, ncol = K, nrow = p+1)
beta[0+1,1] = 0
beta[1+1,1] = beta_par
beta[0+1,2] = gap
beta[1+1,2] = -beta_par
colnames(beta) = paste0("clust", 1:K)
rownames(beta) = c("intercept", "par", "cp", paste0("noise", 1:(p-2)))
## alpha coefficients
alpha = matrix(0, ncol = K, nrow = p+1)
alpha[0+1, 2] = -10
alpha[2+1, 2] = 10 + log(1/4)
colnames(alpha) = paste0("clust", 1:K)
rownames(alpha) = c("intercept", "par", "cp", paste0("noise", 1:(p-2)))
## Generate means and probabilities
mnmat = cbind(1, X) %*% beta
prob = exp(cbind(1,X) %*% alpha)
prob = prob/rowSums(prob)
omega = NULL
mn_shift = NULL
variance = NULL
## Samples |nt| memberships out of (1:K) according to the probs in prob.
## Data is a probabilistic mixture from these two means, over time.
ylist = lapply(1:TT, function(tt){
draws = sample(1:K,
size = ntlist[tt], replace = TRUE,
prob = c(prob[tt,1], prob[tt,2]))
mns = mnmat[tt,]
means = mns[draws]
## Add noise to obtain data points.
if (is_heavytail) {
assertthat::assert_that(df >= 3)
variance = df / (df - 2)
noise = rt(ntlist[tt], df = df) / sqrt(variance)
noisetype = 'heavytail'
} else {
if (skew_alpha == 0){
noise = rnorm(ntlist[tt], 0, 1)
noisetype = 'gaussian'
} else {
omega = sqrt(1/(1 - 2 * (1/pi) * skew_alpha^2 / (1 + skew_alpha^2)))
mn_shift = omega * skew_alpha * (1 / sqrt(1+skew_alpha^2)) * sqrt(2/pi)
noise = sn::rsn(ntlist[tt], xi = 0, omega = omega, alpha = skew_alpha) - mn_shift
noisetype = 'skewed'
}
}
datapoints = means + noise
cbind(datapoints)
})
## 1. Make grid
dat.grid = flowmix::make_grid(ylist, gridsize = grid_size)
## 2. Bin with just counts
mc.cores = 4
obj = flowmix::bin_many_cytograms(ylist, dat.grid, mc.cores = mc.cores, verbose = TRUE)
ylist = obj$ybin_list
countslist = obj$counts_list
sparsecounts_list = obj$sparsecounts_list ## new
ybin_all = obj$ybin_all ## new
## Other things about the true generating model
mn = array(NA,dim=c(100,1,2))
mn[,1,] = mnmat
return(list(ylist = ylist,
X = X,
countslist = countslist,
sparsecounts_list = sparsecounts_list,
ybin_all = ybin_all,
## The true generating model:
noisetype = noisetype,
mnmat = mnmat,
prob = prob,
mn = mn,
alpha = alpha,
beta = beta,
omega = omega,
mn_shift = mn_shift,
variance = variance
))
}
dat = gen_simul_data(
seed = 1,
datdir         = ".",
nt             = 1000,
TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = TRUE,
df             = NULL,
skew_alpha     = NULL,
gap            = 4
)
dat = gen_simul_data(
seed = 1,
datdir         = ".",
nt             = 1000,
TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = F,
df             = NULL,
skew_alpha     = 10,
gap            = 4
)
dat = gen_simul_data(
seed = 1,
datadir         = ".",
nt             = 1000,
TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = F,
df             = NULL,
skew_alpha     = 10,
gap            = 4
)
gen_simul_data <- function(
seed           = NULL,
datadir         = ".",
nt             = 1000,
TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = TRUE,
df             = NULL,
skew_alpha     = NULL,
gap            = 4
) {
## Setup and basic checks
assertthat::assert_that(nt %% 5 ==0)
ntlist = c(rep(0.8 * nt, TT/2), rep(nt, TT/2))
K = 2
stopifnot(p >= 3)
if (is_heavytail){
assertthat::assert_that(!is.null(df))
} else {
assertthat::assert_that(!is.null(skew_alpha))
}
if(!is.null(seed)) set.seed(seed)
## Generate covariate
par = readRDS(file.path(datadir, "simul_helper.rds"))
Xrest = do.call(cbind, lapply(1:(p-2), function(ii) rnorm(TT)) )
X = cbind(scale(par[1:TT]), c(rep(0, TT/2), rep(1, TT/2)), Xrest)## p-2 columns
colnames(X) = c("par", "cp", paste0("noise", 1:(p-2)))
## Beta coefficients
beta = matrix(0, ncol = K, nrow = p+1)
beta[0+1,1] = 0
beta[1+1,1] = beta_par
beta[0+1,2] = gap
beta[1+1,2] = -beta_par
colnames(beta) = paste0("clust", 1:K)
rownames(beta) = c("intercept", "par", "cp", paste0("noise", 1:(p-2)))
## alpha coefficients
alpha = matrix(0, ncol = K, nrow = p+1)
alpha[0+1, 2] = -10
alpha[2+1, 2] = 10 + log(1/4)
colnames(alpha) = paste0("clust", 1:K)
rownames(alpha) = c("intercept", "par", "cp", paste0("noise", 1:(p-2)))
## Generate means and probabilities
mnmat = cbind(1, X) %*% beta
prob = exp(cbind(1,X) %*% alpha)
prob = prob/rowSums(prob)
omega = NULL
mn_shift = NULL
variance = NULL
## Samples |nt| memberships out of (1:K) according to the probs in prob.
## Data is a probabilistic mixture from these two means, over time.
ylist = lapply(1:TT, function(tt){
draws = sample(1:K,
size = ntlist[tt], replace = TRUE,
prob = c(prob[tt,1], prob[tt,2]))
mns = mnmat[tt,]
means = mns[draws]
## Add noise to obtain data points.
if (is_heavytail) {
assertthat::assert_that(df >= 3)
variance = df / (df - 2)
noise = rt(ntlist[tt], df = df) / sqrt(variance)
noisetype = 'heavytail'
} else {
if (skew_alpha == 0){
noise = rnorm(ntlist[tt], 0, 1)
noisetype = 'gaussian'
} else {
omega = sqrt(1/(1 - 2 * (1/pi) * skew_alpha^2 / (1 + skew_alpha^2)))
mn_shift = omega * skew_alpha * (1 / sqrt(1+skew_alpha^2)) * sqrt(2/pi)
noise = sn::rsn(ntlist[tt], xi = 0, omega = omega, alpha = skew_alpha) - mn_shift
noisetype = 'skewed'
}
}
datapoints = means + noise
cbind(datapoints)
})
## 1. Make grid
dat.grid = flowmix::make_grid(ylist, gridsize = grid_size)
## 2. Bin with just counts
mc.cores = 4
obj = flowmix::bin_many_cytograms(ylist, dat.grid, mc.cores = mc.cores, verbose = TRUE)
ylist = obj$ybin_list
countslist = obj$counts_list
sparsecounts_list = obj$sparsecounts_list ## new
ybin_all = obj$ybin_all ## new
## Other things about the true generating model
mn = array(NA,dim=c(100,1,2))
mn[,1,] = mnmat
return(list(ylist = ylist,
X = X,
countslist = countslist,
sparsecounts_list = sparsecounts_list,
ybin_all = ybin_all,
## The true generating model:
noisetype = noisetype,
mnmat = mnmat,
prob = prob,
mn = mn,
alpha = alpha,
beta = beta,
omega = omega,
mn_shift = mn_shift,
variance = variance
))
}
dat = gen_simul_data(
seed           = 1,
datadir       = ".",
nt             = 1000,
TT             = 100,
beta_par       = 0.5,
p              = 10,
grid_size      = 30,
is_heavytail   = F,
df             = NULL,
skew_alpha     = 10,
gap            = 4
)
knitr::opts_chunk$set(echo = TRUE)
opt_pairs = matrix(0, ncol = 2, nrow = n_sims)
sim = readRDS('sim_mat.rds')
n_sims = nrow(sim)
summ = readRDS("cv_summ_trimmed.rds")
refit = readRDS("refit_res.rds")
refit_tbl = readRDS("refit_tbl.rds")
refit_bests = readRDS('refit_bests.rds')
refit$summary # Failures: 8/400 (2.0%)
refit$best_table
opt_pairs = matrix(0, ncol = 2, nrow = n_sims)
for (i in 1:n_sims){
opt_pairs[i, ] = summ[[i]]$opt_lambdas
}
la = factor(opt_pairs[,1], levels = unique(summ[[1]]$CVmat$lambda_alpha))
lt = factor(opt_pairs[,2], levels = unique(summ[[1]]$CVmat$lambda_theta))
#table(la)
#table(lt)
table(la, lt) # no case where lt = 0.001
sim = cbind(sim_idx = 1:n_sims, gap = sim[, 2], skew = sim[, 3])
lambda_tbl = cbind(sim, opt_pairs)
colnames(lambda_tbl)[4:5] = c('la', 'lt')
lambda_tbl
sum(NAs)
NAs = rep(0, n_sims)
for (i in 1:n_sims){
v = summ[[i]]$CVmat$fit_trimmed_loglik
#  NAs[i] = mean(is.na(v))
NAs[i] = sum(is.na(v))
}
sum(NAs)
do.call(nrow, summ)
lapply(nrow, summ)
lapply(summ, nrow)
lapply(summ, function(x) nrow(x$CVmat))
do.call(lapply(summ, function(x) nrow(x$CVmat)))
do.call(sum, lapply(summ, function(x) nrow(x$CVmat)))
print(sprintf("Failures: %d/%d (%.2f%%)", sum(NAs), N, 100 * sum(NAs)/N))
N = do.call(sum, lapply(summ, function(x) nrow(x$CVmat)))
print(sprintf("Failures: %d/%d (%.2f%%)", sum(NAs), N, 100 * sum(NAs)/N))
lambda_tbl
s = 1 # gap 2 skew 0
mat = summ[[s]]$reduced_mat
print(summ[[s]]$opt_lambdas)
lambda_alphas <- unique(mat[,'lambda_alpha'])
par(mfrow = c(1,2), pty = "s", cex = 0.7)
for (lambda_alpha in lambda_alphas) {
small_mat <- mat[mat[,"lambda_alpha"] == lambda_alpha, ]
plot(
small_mat[,'lambda_theta'],
small_mat[,'cv_score'],
type = "b",
xlab = "lambda_theta", ylab = "cv_score",
log = 'x',
main = paste0("lambda_alpha = ", round(lambda_alpha, 5))
)
}
library(ggplot2)
library(dplyr)
library(scales)
cv_grid <- as.data.frame(mat)
best <- cv_grid %>% slice_max(cv_score, n = 1)
ggplot(cv_grid, aes(x = lambda_alpha, y = lambda_theta, fill = cv_score)) +
geom_tile() +
geom_point(data = best, shape = 21, size = 3, color = "white", fill = "red") +
geom_text(data = best, aes(label = sprintf("max=%.3f", cv_score)),
nudge_x = 0, nudge_y = 0, vjust = -1, size = 3.2, color = "red") +
scale_x_log10(labels = label_scientific(digits = 2)) +
scale_y_log10(labels = label_scientific(digits = 2)) +
scale_fill_viridis_c(name = "cv_score", option = "C") +
labs(x = expression(lambda[alpha]), y = expression(lambda[theta]),
title = "CV score over (lambda_alpha, lambda_theta)") +
coord_fixed() +
theme_minimal(base_size = 12) +
theme(panel.grid.minor = element_blank())
flow_bests = readRDS('flow_res_bests.rds')
flow = flow_bests[[s]]
res = refit_bests[[s]]
X = res$X
Y_bin = res$Y_bin
bin_mass = res$bin_mass
K = 2
print("Best labmda for flowmix:")
print(c(flow$prob_lambda, flow$mean_lambda)) # 1e-04 1e-08
print("Best labmda for LCDMix:")
print(c(res$iter$lambda_alpha, res$iter$lambda_theta)) # 1e-08 1e-08
##— 2. Plot surrogate Q over iterations —##
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
res$iter$Q, type = "b",
xlab = "Iteration", ylab = "Surrogate Q",
main = "Convergence of Q"
)
# Print the raw Q values for inspection
print("Surrogate Q values:")
print(res$iter$Q)
print(paste("The number of iterations:", res$iter$iter_num))
##— 3. Extract parameter estimates —##
#   theta : intercept + slopes;   alpha : mixture‐weight coefficients
theta_est_flow <- do.call(cbind, flow$beta)
theta_est_lcd  <- rbind(
do.call(cbind, res$iter$theta0_new),  # intercepts
do.call(cbind, res$iter$theta_new)    # slopes
)
rownames(theta_est_lcd) = rownames(theta_est_flow)
colnames(theta_est_lcd) = colnames(theta_est_flow)
alpha_est_flow  <- t(sweep(flow$alpha, 2, flow$alpha[1, ], FUN = "-")) # (p+1) × K
alpha_est_lcd  <- t(res$iter$alpha_new)
rownames(theta_est_lcd) = rownames(theta_est_flow)
colnames(theta_est_lcd) = colnames(theta_est_flow)
print("Theta estimates (rows=intercept+slopes, cols=components):")
print(theta_est_flow)
print(theta_est_lcd)
print("Theta sparsity (proportion of < 1e-6):")
print(mean(abs(theta_est_flow[-1,]) < 1e-6)) # 0.45
print(mean(abs(theta_est_lcd[-1,])  < 1e-6)) # 1
print("Alpha estimates (rows=components, cols=intercept+slopes):")
print(alpha_est_flow)
print(alpha_est_lcd)
print("Alpha sparsity (proportion of < 1e-6):")
print(mean(abs(as.numeric(alpha_est_flow[-1, -1, drop = FALSE])) < 1e-6, na.rm = TRUE)) # 0.5
print(mean(abs(as.numeric(alpha_est_lcd[-1, -1, drop = FALSE])) < 1e-6, na.rm = TRUE))  # 0.9
##— 4. Binned data over time —##
#  Heatmap of binned mass over time
mids   <- sort(unique(unlist(res$Y_bin)))
n_time <- length(res$Y_bin)
heat_mat <- matrix(0, nrow = length(mids), ncol = n_time)
for (t in seq_len(n_time)) {
rows <- match(res$Y_bin[[t]], mids)
heat_mat[rows, t] <- res$bin_mass[[t]]
}
zmat <- t(heat_mat)  # transpose for image()
layout(matrix(1:2, nrow = 1), widths = c(4, 1.5))
image(
1:n_time, mids, zmat,
col       = rev(heat.colors(100)),
xlab      = "Time (t)",
ylab      = "Response Y (bin midpoints)",
main      = "Heatmap of bin_mass over time"
#  useRaster = TRUE
)
par(mar = c(5, 2, 4, 4))    # bottom, left, top, right
breaks <- seq(min(heat_mat), max(heat_mat), length.out = 100)
image(
x    = 1,               # dummy x position
y    = breaks,          # vertical scale = your data range
z    = matrix(breaks, nrow = 1, ncol = length(breaks)),
col  = rev(heat.colors(100)),
axes = FALSE, xlab = "", ylab = ""
)
axis(
side = 4, at = pretty(breaks), labels = pretty(breaks),
las = 1,cex.axis = 0.7)
mtext("bin_mass", side = 4, line = 2.5, cex  = 0.7)
layout(1)
#   Bubble size ~ bin_mass
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Observed data (bubble ~ mass)"
)
for (t in seq_len(n_time)) {
points(
rep(t, length(res$Y_bin[[t]])),
res$Y_bin[[t]],
cex = 10 * res$bin_mass[[t]] / sum(res$bin_mass[[t]])
)
}
##— 5. Mean‐curve computations —##
mean_curves_flow <- cbind(1, X) %*% theta_est_flow
mean_curves_lcd  <- cbind(1, X) %*% theta_est_lcd
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Flowmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$initial$resp_init[[t]], 1, which.max) # not from flowmix, but flowmix doesn't offer the membership info
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_flow[, k], lwd = 2)
}
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "LCDmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$iter$resp_new[[t]], 1, which.max)
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_lcd[, k], lwd = 2)
}
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Flowmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
points(
rep(t, length(res$Y_bin[[t]])),
res$Y_bin[[t]],
cex = 10 * res$bin_mass[[t]] / sum(res$bin_mass[[t]])
)
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_flow[, k], lwd = 2, col = k + 1)
}
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "LCDmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$iter$resp_new[[t]], 1, which.max)
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_lcd[, k], lwd = 2)
}
?logcondens::evaluateLogConDens
