iter_eta            = 1e-3
resp_threshold      = 1e-3
nfold               = 5
seeds               = 1:5
trim_prob           = 0.01
n_cores             = 6
save_path <- file.path(cv_results, paste0('meta.Rdata'))
save(K, alpha_lambdas, theta_lambdas,
max_iter, iter_eta, resp_threshold, nfold,
seeds, trim_prob, file = save_path)
