flow_bests = readRDS('flow_res_bests.rds')
flow = flow_bests[[s]]
res = refit_bests[[s]]
X = res$X
Y_bin = res$Y_bin
bin_mass = res$bin_mass
K = 2
print("Best labmda for flowmix:")
print(c(flow$prob_lambda, flow$mean_lambda)) # 1e-04 1e-08
print("Best labmda for LCDMix:")
print(c(res$iter$lambda_alpha, res$iter$lambda_theta)) # 1e-08 1e-08
##— 2. Plot surrogate Q over iterations —##
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
res$iter$Q, type = "b",
xlab = "Iteration", ylab = "Surrogate Q",
main = "Convergence of Q"
)
# Print the raw Q values for inspection
print("Surrogate Q values:")
print(res$iter$Q)
print(paste("The number of iterations:", res$iter$iter_num))
##— 3. Extract parameter estimates —##
#   theta : intercept + slopes;   alpha : mixture‐weight coefficients
theta_est_flow <- do.call(cbind, flow$beta)
theta_est_lcd  <- rbind(
do.call(cbind, res$iter$theta0_new),  # intercepts
do.call(cbind, res$iter$theta_new)    # slopes
)
rownames(theta_est_lcd) = rownames(theta_est_flow)
colnames(theta_est_lcd) = colnames(theta_est_flow)
alpha_est_flow  <- t(sweep(flow$alpha, 2, flow$alpha[1, ], FUN = "-")) # (p+1) × K
alpha_est_lcd  <- t(res$iter$alpha_new)
rownames(theta_est_lcd) = rownames(theta_est_flow)
colnames(theta_est_lcd) = colnames(theta_est_flow)
print("Theta estimates (rows=intercept+slopes, cols=components):")
print(theta_est_flow)
print(theta_est_lcd)
print("Theta sparsity (proportion of < 1e-6):")
print(mean(abs(theta_est_flow[-1,]) < 1e-6)) # 0.45
print(mean(abs(theta_est_lcd[-1,])  < 1e-6)) # 1
print("Alpha estimates (rows=components, cols=intercept+slopes):")
print(alpha_est_flow)
print(alpha_est_lcd)
print("Alpha sparsity (proportion of < 1e-6):")
print(mean(abs(as.numeric(alpha_est_flow[-1, -1, drop = FALSE])) < 1e-6, na.rm = TRUE)) # 0.5
print(mean(abs(as.numeric(alpha_est_lcd[-1, -1, drop = FALSE])) < 1e-6, na.rm = TRUE))  # 0.9
##— 4. Binned data over time —##
#  Heatmap of binned mass over time
mids   <- sort(unique(unlist(res$Y_bin)))
n_time <- length(res$Y_bin)
heat_mat <- matrix(0, nrow = length(mids), ncol = n_time)
for (t in seq_len(n_time)) {
rows <- match(res$Y_bin[[t]], mids)
heat_mat[rows, t] <- res$bin_mass[[t]]
}
zmat <- t(heat_mat)  # transpose for image()
layout(matrix(1:2, nrow = 1), widths = c(4, 1.5))
image(
1:n_time, mids, zmat,
col       = rev(heat.colors(100)),
xlab      = "Time (t)",
ylab      = "Response Y (bin midpoints)",
main      = "Heatmap of bin_mass over time"
#  useRaster = TRUE
)
par(mar = c(5, 2, 4, 4))    # bottom, left, top, right
breaks <- seq(min(heat_mat), max(heat_mat), length.out = 100)
image(
x    = 1,               # dummy x position
y    = breaks,          # vertical scale = your data range
z    = matrix(breaks, nrow = 1, ncol = length(breaks)),
col  = rev(heat.colors(100)),
axes = FALSE, xlab = "", ylab = ""
)
axis(
side = 4, at = pretty(breaks), labels = pretty(breaks),
las = 1,cex.axis = 0.7)
mtext("bin_mass", side = 4, line = 2.5, cex  = 0.7)
layout(1)
#   Bubble size ~ bin_mass
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Observed data (bubble ~ mass)"
)
for (t in seq_len(n_time)) {
points(
rep(t, length(res$Y_bin[[t]])),
res$Y_bin[[t]],
cex = 10 * res$bin_mass[[t]] / sum(res$bin_mass[[t]])
)
}
##— 5. Mean‐curve computations —##
mean_curves_flow <- cbind(1, X) %*% theta_est_flow
mean_curves_lcd  <- cbind(1, X) %*% theta_est_lcd
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Flowmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$initial$resp_init[[t]], 1, which.max) # not from flowmix, but flowmix doesn't offer the membership info
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_flow[, k], lwd = 2)
}
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "LCDmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$iter$resp_new[[t]], 1, which.max)
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_lcd[, k], lwd = 2)
}
par(mfrow = c(1,2), pty = "s", cex = 0.7)
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "Flowmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
points(
rep(t, length(res$Y_bin[[t]])),
res$Y_bin[[t]],
cex = 10 * res$bin_mass[[t]] / sum(res$bin_mass[[t]])
)
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_flow[, k], lwd = 2, col = k + 1)
}
plot(
NA, xlim = c(1, n_time), ylim = range(res$Y_bin),
xlab = "t", ylab = "y",
main = "LCDmix clusters & mean curves"
)
for (t in seq_len(n_time)) {
cluster_ids <- apply(res$iter$resp_new[[t]], 1, which.max)
for (k in seq_len(K)) {
idx <- which(cluster_ids == k)
points(
rep(t, length(idx)),
res$Y_bin[[t]][idx],
col = k + 1,
cex = 10 * res$bin_mass[[t]][idx] / sum(res$bin_mass[[t]])
)
}
}
for (k in seq_len(K)) {
lines(seq_len(n_time), mean_curves_lcd[, k], lwd = 2)
}
