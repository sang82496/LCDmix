devtools::install_github("sang82496/LCDmix/LCDmix")
library(LCDmix)
knitr::opts_chunk$set(echo = TRUE)
train.data <- read.csv("dataset3_train.csv")
summary(train.data$Y)
#    Min.  1st Qu.   Median     Mean  3rd Qu.     Max.
# -4.3454 -1.4081 -0.0821 -0.0402  1.3267   4.2885
cor.vec <- cor(train.data)[-1, "Y"]  # correlations of X's with Y
sort(abs(cor.vec), decreasing=TRUE)[1:5]
#      X51       X50       X55       X32       X59
# 0.5244782 0.2597718 0.0633745 0.0595045 0.0580263
# Linear regression on all features
lm.full <- lm(Y ~ ., data=train.data)
summary(lm.full)$r.squared  # training R^2
summary(lm.full)$coefficients[1:5, ]  # show a few coefficients
library(glmnet)
x <- model.matrix(Y ~ ., data=train.data)[,-1]  # model matrix (drop intercept column)
y <- train.data$Y
set.seed(123)
cv.ridge <- cv.glmnet(x, y, alpha=0, nfolds=5)
best.lambda <- cv.ridge$lambda.min
best.lambda  # optimal penalty
ridge.model <- glmnet(x, y, alpha=0, lambda=best.lambda)
# Cross-validated performance:
cv.ridge$cvm[cv.ridge$lambda == best.lambda]  # CV MSE at best lambda
sqrt(cv.ridge$cvm[cv.ridge$lambda == best.lambda])  # CV RMSE
library(randomForest)
set.seed(123)
rf.model <- randomForest(Y ~ ., data=train.data, ntree=500)
print(rf.model)
# OOB results: %Var explained and MSE
importance(rf.model)[order(rf.model$importance, decreasing=TRUE)[1:5], ]
lm.trans <- lm(Y ~ X50 + X51 + I(X50^2) + I(X51^2) + I(X50*X51), data=train.data)
summary(lm.trans)$r.squared
# Using the chosen random forest model to predict test set and form intervals
test.preds <- predict(rf.model, newdata=test.data)
# Using the chosen random forest model to predict test set and form intervals
test.data <- read.csv("dataset3_test.csv")
test.preds <- predict(rf.model, newdata=test.data)
residuals <- train.data$Y - predict(rf.model, newdata=train.data)
half.width <- as.numeric(quantile(abs(residuals), 0.95))
intervals <- data.frame(
Lower = test.preds - half.width,
Upper = test.preds + half.width
)
write.csv(intervals, "result.csv", row.names=FALSE)
knitr::opts_chunk$set(echo = TRUE)
pred = read.csv("result_v15.csv")
test = read.csv("dataset3_test_with_Y.csv")
mean((pred$Lower <= test$Y) & (test$Y <= pred$Upper))
mean(pred$Upper - pred$Lower)
head(pred$Upper - pred$Lower)
