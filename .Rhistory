library(LCDmix)
mat = simul_idx_matrix(
n_sims        = 1,
alpha_lambdas = c(0.001, 0.01),
theta_lambdas = c(0.001, 0.01),
seeds         = 1:2,
nfold         = 5
)
mat
print(nrow(mat))
best_table = summarize_simul_cv(simul_idx_mat = mat, save_dir = "cv_saves")
best_table
simul_idx_mat = mat
save_dir = "cv_saves"
sim = 1
idx_mat <- simul_idx_mat[simul_idx_mat[,"sim_idx"] == sim, -1]
idx_mat
sim
index_matrix = idx_mat
save_dir = save_dir
simul    = TRUE
sim_idx  = 1
out     <- LCD_cv_summary(idx_mat, save_dir, simul = TRUE, sim_idx = sim)
out$CVmat
as.matrix(out$CVmat)
ord <- with(CVmat,
order(alpha_idx, theta_idx, fold_idx, -Q_final, na.last = TRUE)  # NA Q go last
)
CVmat = out$CVmat
## 4) For each (alpha_idx, theta_idx, fold_idx), keep the row with largest Q_final
# Order so that within each (alpha,theta,fold) the first row has max Q_final (NAs go last)
ord <- with(CVmat,
order(alpha_idx, theta_idx, fold_idx, -Q_final, na.last = TRUE)  # NA Q go last
)
ord
selected <- CVmat[ord, ]
selected
selected <- selected[!duplicated(selected[c("alpha_idx","theta_idx","fold_idx")]), ]
selected
best_by_combo <- aggregate(
trimmed_CV ~ alpha_idx + theta_idx,
data = selected,
FUN  = function(x) mean(x, na.rm = TRUE)
)
selected
mean(selected[1:5, "trimmed_CV"])
best_by_combo
best_table = summarize_simul_cv(simul_idx_mat = mat, save_dir = "cv_saves")
res = simul_refit(
best_table = best_table,
sim_dir = "sim_data",
save_dir = "cv_saves",
K                  = 2,
max_iter           = 20,
iter_eta           = 1e-3,
resp_threshold     = 1e-3,
refit_seeds        = 1:5,
n_cores            = "max"
)
res$res_table
res$res_logs
